{
  "Comment": "v0.5.0: approval → order → Wait → idempotent stock add or compensation → ReleaseLock",
  "StartAt": "PutRestockRequest",
  "States": {
    "PutRestockRequest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Item": {
          "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
          "sk": { "S.$": "States.Format('RESTOCK#{}', $.streamEventId)" },
          "entityType": { "S": "RESTOCK" },
          "itemId": { "S.$": "$.itemId" },
          "stock": { "N.$": "States.Format('{}', $.stock)" },
          "threshold": { "N.$": "States.Format('{}', $.threshold)" },
          "streamEventId": { "S.$": "$.streamEventId" },
          "orderFailureMode": { "S.$": "$.orderFailureMode" },
          "deliveryOutcome": { "S.$": "$.deliveryOutcome" },
          "restockQty": { "N.$": "States.Format('{}', $.restockQty)" },
          "status": { "S": "RECORDED" }
        },
        "ConditionExpression": "attribute_not_exists(pk) AND attribute_not_exists(sk)"
      },
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "AlreadyRecorded"
        }
      ],
      "Next": "WaitForApproval"
    },
    "AlreadyRecorded": {
      "Type": "Pass",
      "Comment": "Same stream eventID already recorded; keep itemId/streamEventId",
      "Next": "WaitForApproval"
    },
    "WaitForApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": ${ApprovalTimeoutSeconds},
      "Parameters": {
        "FunctionName": "${StoreTokenFunctionArn}",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "itemId.$": "$.itemId",
          "streamEventId.$": "$.streamEventId"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.error",
          "Next": "MarkTimedOut"
        },
        {
          "ErrorEquals": ["ApprovalRejected"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        },
        {
          "ErrorEquals": ["ALREADY_TERMINAL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "ResultPath": "$.approvalResult",
      "Next": "MarkOrdering"
    },
    "MarkTimedOut": {
      "Type": "Task",
      "Comment": "Only AWAITING/RECORDED → TIMED_OUT; never overwrite APPROVED/REJECTED",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
          "sk": { "S.$": "States.Format('RESTOCK#{}', $.streamEventId)" }
        },
        "UpdateExpression": "SET #s = :timed REMOVE taskToken",
        "ConditionExpression": "#s = :awaiting OR #s = :recorded",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": {
          ":timed": { "S": "TIMED_OUT" },
          ":awaiting": { "S": "AWAITING_APPROVAL" },
          ":recorded": { "S": "RECORDED" }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        }
      ],
      "ResultPath": "$.markTimedOut",
      "Next": "ReleaseLock"
    },
    "MarkFailed": {
      "Type": "Task",
      "Comment": "Only non-terminal → FAILED; do not overwrite approve/reject/timeout",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
          "sk": { "S.$": "States.Format('RESTOCK#{}', $.streamEventId)" }
        },
        "UpdateExpression": "SET #s = :failed REMOVE taskToken",
        "ConditionExpression": "#s = :awaiting OR #s = :recorded",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": {
          ":failed": { "S": "FAILED" },
          ":awaiting": { "S": "AWAITING_APPROVAL" },
          ":recorded": { "S": "RECORDED" }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        }
      ],
      "ResultPath": "$.markFailed",
      "Next": "ReleaseLock"
    },
    "MarkOrdering": {
      "Type": "Task",
      "Comment": "APPROVED → ORDERING after callback",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
          "sk": { "S.$": "States.Format('RESTOCK#{}', $.streamEventId)" }
        },
        "UpdateExpression": "SET #s = :ordering",
        "ConditionExpression": "#s = :approved",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": {
          ":ordering": { "S": "ORDERING" },
          ":approved": { "S": "APPROVED" }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CancelOrder"
        }
      ],
      "ResultPath": "$.markOrdering",
      "Next": "PlaceOrder"
    },
    "PlaceOrder": {
      "Type": "Task",
      "Comment": "OrderTransientError → Retry; permanent/exhausted → CancelOrder",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrderFunctionArn}",
        "Payload": {
          "itemId.$": "$.itemId",
          "streamEventId.$": "$.streamEventId",
          "orderFailureMode.$": "$.orderFailureMode"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["OrderTransientError"],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 1.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["OrderPermanentError"],
          "ResultPath": "$.error",
          "Next": "CancelOrder"
        },
        {
          "ErrorEquals": ["OrderTransientError"],
          "ResultPath": "$.error",
          "Next": "CancelOrder",
          "Comment": "Retries exhausted"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CancelOrder"
        }
      ],
      "ResultSelector": {
        "orderId.$": "$.Payload.orderId",
        "arriveAt.$": "$.Payload.arriveAt"
      },
      "ResultPath": "$.order",
      "Next": "MarkShippingWait"
    },
    "CancelOrder": {
      "Type": "Task",
      "Comment": "補償1: 注文取消（冪等フラグ orderCancelled）",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
          "sk": { "S.$": "States.Format('RESTOCK#{}', $.streamEventId)" }
        },
        "UpdateExpression": "SET orderCancelled = :true",
        "ConditionExpression": "attribute_not_exists(orderCancelled) OR orderCancelled = :false",
        "ExpressionAttributeValues": {
          ":true": { "BOOL": true },
          ":false": { "BOOL": false }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "CancelRestockRequest",
          "Comment": "Already cancelled; continue saga"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CancelRestockRequest"
        }
      ],
      "ResultPath": "$.cancelOrder",
      "Next": "CancelRestockRequest"
    },
    "CancelRestockRequest": {
      "Type": "Task",
      "Comment": "補償2: 補充リクエスト取消（冪等フラグ restockCancelled）",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
          "sk": { "S.$": "States.Format('RESTOCK#{}', $.streamEventId)" }
        },
        "UpdateExpression": "SET restockCancelled = :true, #s = :cancelled",
        "ConditionExpression": "attribute_not_exists(restockCancelled) OR restockCancelled = :false",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": {
          ":true": { "BOOL": true },
          ":false": { "BOOL": false },
          ":cancelled": { "S": "CANCELLED" }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock",
          "Comment": "Already cancelled; still release occupancy"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        }
      ],
      "ResultPath": "$.cancelRestock",
      "Next": "ReleaseLock"
    },
    "MarkShippingWait": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
          "sk": { "S.$": "States.Format('RESTOCK#{}', $.streamEventId)" }
        },
        "UpdateExpression": "SET #s = :ship, arriveAt = :eta",
        "ConditionExpression": "#s = :ordering",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": {
          ":ship": { "S": "SHIPPING_WAIT" },
          ":ordering": { "S": "ORDERING" },
          ":eta": { "S.$": "$.order.arriveAt" }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CancelOrder"
        }
      ],
      "ResultPath": "$.markShipping",
      "Next": "WaitForDelivery"
    },
    "WaitForDelivery": {
      "Type": "Wait",
      "Comment": "Datetime Wait via TimestampPath (shorten DeliveryWaitSeconds for verify)",
      "TimestampPath": "$.order.arriveAt",
      "Next": "ChooseDeliveryOutcome"
    },
    "ChooseDeliveryOutcome": {
      "Type": "Choice",
      "Comment": "Test input deliveryOutcome=not_arrived → compensation; else arrive",
      "Choices": [
        {
          "Variable": "$.deliveryOutcome",
          "StringEquals": "not_arrived",
          "Next": "CancelOrder"
        }
      ],
      "Default": "ConfirmArrival"
    },
    "ConfirmArrival": {
      "Type": "Task",
      "Comment": "SHIPPING_WAIT → ARRIVAL_CONFIRMED; stock add is ApplyStock",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
          "sk": { "S.$": "States.Format('RESTOCK#{}', $.streamEventId)" }
        },
        "UpdateExpression": "SET #s = :arrived",
        "ConditionExpression": "#s = :ship",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": {
          ":arrived": { "S": "ARRIVAL_CONFIRMED" },
          ":ship": { "S": "SHIPPING_WAIT" }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "ApplyStock",
          "Comment": "Already confirmed; still try idempotent apply"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        }
      ],
      "ResultPath": "$.confirmArrival",
      "Next": "ApplyStock"
    },
    "ApplyStock": {
      "Type": "Task",
      "Comment": "Transact: claim stockApplied + ADD META.stock (no Lambda)",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:transactWriteItems",
      "Parameters": {
        "TransactItems": [
          {
            "Update": {
              "TableName": "${TableName}",
              "Key": {
                "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
                "sk": { "S.$": "States.Format('RESTOCK#{}', $.streamEventId)" }
              },
              "UpdateExpression": "SET stockApplied = :true, #s = :completed",
              "ConditionExpression": "attribute_not_exists(stockApplied) AND #s = :arrived",
              "ExpressionAttributeNames": { "#s": "status" },
              "ExpressionAttributeValues": {
                ":true": { "BOOL": true },
                ":completed": { "S": "COMPLETED" },
                ":arrived": { "S": "ARRIVAL_CONFIRMED" }
              }
            }
          },
          {
            "Update": {
              "TableName": "${TableName}",
              "Key": {
                "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
                "sk": { "S": "META" }
              },
              "UpdateExpression": "ADD stock :qty",
              "ConditionExpression": "attribute_exists(pk)",
              "ExpressionAttributeValues": {
                ":qty": { "N.$": "States.Format('{}', $.restockQty)" }
              }
            }
          }
        ]
      },
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.TransactionCanceledException"],
          "ResultPath": "$.error",
          "Next": "StockAlreadyApplied",
          "Comment": "Second arrival / already claimed → no double ADD"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseLock"
        }
      ],
      "ResultPath": "$.applyStock",
      "Next": "ReleaseLock"
    },
    "StockAlreadyApplied": {
      "Type": "Pass",
      "Comment": "Idempotent skip after duplicate arrival notification",
      "Next": "ReleaseLock"
    },
    "ReleaseLock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": { "S.$": "States.Format('ITEM#{}', $.itemId)" },
          "sk": { "S": "LOCK" }
        },
        "ConditionExpression": "streamEventId = :eid",
        "ExpressionAttributeValues": {
          ":eid": { "S.$": "$.streamEventId" }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": "$.error",
          "Next": "Done",
          "Comment": "Lock already gone or owned by another eventId"
        }
      ],
      "ResultPath": "$.releaseLock",
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
